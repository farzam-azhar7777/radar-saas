<% messages = posting.messages.to_a %>
<% replying = posting.replying? %>
<% asking = messages.last&.role == "ask" %>
<section id="conversation" class="panel overflow-hidden scroll-mt-6">
  <div class="border-b border-rule px-6 py-4">
    <h2 class="heading">Conversation with the client</h2>
    <p class="hint mt-0.5">Paste what the client writes and Radar drafts your reply. Ask Radar anything along the way: more detail, ideas, a shorter version. It remembers the job, your proposal and the whole thread. <%= link_to "Change how replies are written", edit_reply_style_path, class: "font-semibold text-brand hover:underline" %></p>
  </div>

  <% if messages.any? %>
    <ol class="space-y-4 px-6 py-5">
      <% messages.each do |m| %>
        <% mine = m.role.in?(%w[me ask]) %>
        <li id="<%= dom_id(m) %>" class="flex <%= mine ? 'justify-end' : 'justify-start' %>">
          <div class="w-full max-w-[88%]">
            <div class="flex items-center gap-2 text-[0.75rem] font-semibold text-muted <%= 'flex-row-reverse' if mine %>">
              <span>
                <% case m.role
                   when "client" then %>Client
                <% when "me" then %>You<span class="font-normal text-faint"><%= m.drafted? ? ", drafted by Radar" : ", sent" %></span>
                <% when "ask" then %>You asked Radar<span class="font-normal text-faint">, only you see this</span>
                <% when "radar" then %>Radar<span class="font-normal text-faint">, only you see this</span>
                <% end %>
              </span>
              <span class="font-normal text-faint"><%= time_ago_in_words(m.created_at) %> ago</span>
              <%= button_to icon(:x, css: "h-3.5 w-3.5"), job_posting_message_path(posting, m), method: :delete,
                    class: "rounded p-0.5 text-faint hover:text-signal", form: { class: mine ? "mr-auto" : "ml-auto" },
                    title: "Remove this message", "aria-label": "Remove this message",
                    data: { turbo_confirm: "Remove this message from the conversation?" } %>
            </div>

            <% case m.role %>
            <% when "client" %>
              <div class="mt-1 whitespace-pre-wrap rounded-2xl rounded-tl-sm bg-sunk px-4 py-3 text-[0.875rem] leading-relaxed"><%= m.body %></div>
              <% if m.note.present? %><p class="mt-1 text-[0.75rem] text-muted">Your note: <%= m.note %></p><% end %>
            <% when "ask" %>
              <div class="mt-1 whitespace-pre-wrap rounded-2xl rounded-tr-sm border border-dashed border-brand/50 bg-brand-soft px-4 py-2.5 text-[0.875rem] leading-relaxed"><%= m.body %></div>
            <% when "radar" %>
              <div class="mt-1 rounded-2xl rounded-tl-sm border border-dashed border-rule-strong px-4 py-3" data-controller="clipboard">
                <div class="whitespace-pre-wrap text-[0.875rem] leading-relaxed" data-clipboard-target="source"><%= m.body %></div>
                <button type="button" class="btn btn-ghost btn-sm mt-1 -ml-2" data-action="clipboard#copy" data-clipboard-target="button"><%= icon(:copy) %> <span>Copy</span></button>
              </div>
            <% else %>
              <%= form_with model: m, url: job_posting_message_path(posting, m), method: :patch, class: "mt-1", data: { controller: "clipboard" } do |f| %>
                <%= f.text_area :body, rows: 3, class: "textarea !mt-0 rounded-2xl rounded-tr-sm border-brand/40 text-[0.875rem] leading-relaxed [field-sizing:content]",
                      data: { clipboard_target: "source" }, "aria-label": "Your reply" %>
                <div class="mt-1.5 flex flex-wrap items-center justify-end gap-2">
                  <span class="text-[0.75rem] text-faint">Edit it to match what you sent.</span>
                  <%= f.button class: "btn btn-ghost btn-sm" do %><%= icon(:check) %> Save my edits<% end %>
                  <button type="button" class="btn btn-secondary btn-sm" data-action="clipboard#copy" data-clipboard-target="button"><%= icon(:copy) %> <span>Copy</span></button>
                </div>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>

  <% if replying %>
    <% notes = [ asking ? "Reading your question and the conversation." : "Reading the conversation and your proposal.",
                 asking ? "Working on it." : "Drafting your reply.",
                 "Taking longer than usual. Claude may be reading your project files.",
                 "Well past the usual time. It stops itself at the timeout.",
                 "Past the timeout. Press Try again when it clears." ] %>
    <div class="border-t border-rule bg-surface px-6 py-5"
         data-controller="generation"
         data-generation-started-at-value="<%= (posting.reply_queued_at.to_f * 1000).round %>"
         data-generation-typical-value="<%= Message.typical_reply_seconds %>"
         data-generation-timeout-value="<%= JobPosting::REPLY_DEADLINE.to_i %>"
         data-generation-url-value="<%= job_posting_path(posting) %>"
         data-generation-pane-value="#conversation"
         data-generation-notes-value="<%= notes.to_json %>">
      <div class="flex items-center gap-3">
        <span class="ping"></span>
        <p class="font-semibold"><%= asking ? "Radar is answering" : "Writing your reply" %></p>
        <span class="ml-auto text-[0.8125rem] tnum text-muted" data-generation-target="elapsed"></span>
        <%= button_to "Stop", stop_job_posting_messages_path(posting), class: "btn btn-secondary btn-sm",
              title: "Stop waiting. Whatever this run writes is thrown away." %>
      </div>
      <div class="meter mt-3"><i style="width: 2%; background: var(--color-brand)" data-generation-target="bar"></i></div>
      <p class="hint mt-2.5" data-generation-target="note"><%= notes.first %></p>
      <p class="mt-1 text-[0.75rem] text-faint">Usually about <%= Message.typical_reply_seconds %> seconds. This updates itself, and keeps checking even if the live connection drops.</p>
    </div>
  <% elsif posting.reply_error.present? || messages.last&.awaits_radar? %>
    <div class="notice <%= posting.reply_error.present? ? 'notice-signal' : 'notice-warn' %> mx-6 mb-5">
      <%= icon(:alert, css: "mt-0.5 h-4 w-4 flex-none") %>
      <div class="flex-1"><%= posting.reply_error.presence || "Radar hasn't answered your last message." %>
        <% if messages.last&.awaits_radar? %>
          <%= button_to (posting.reply_error.present? ? "Try again" : "Answer now"), redraft_job_posting_messages_path(posting), class: "btn btn-secondary btn-sm mt-2" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% placeholders = { "client" => "Paste the client's message, or copy the whole conversation from Upwork and paste it here.",
                      "ask" => "Ask Radar: give me two more ideas for area 2, make the last reply shorter, what should I quote?" } %>
  <%= form_with model: Message.new, url: job_posting_messages_path(posting), data: { controller: "composer" },
        class: "group/composer space-y-3 border-t border-rule bg-surface px-6 py-4" do |f| %>
    <div class="inline-flex gap-1 rounded-[10px] bg-sunk p-1" role="radiogroup" aria-label="Who this is from">
      <% [ [ "client", "Client wrote" ], [ "ask", "Ask Radar" ] ].each_with_index do |(value, label), i| %>
        <label class="cursor-pointer rounded-[7px] px-3 py-1 text-[0.8125rem] font-semibold text-muted has-[:checked]:bg-paper has-[:checked]:text-ink has-[:checked]:shadow-sm">
          <%= f.radio_button :role, value, checked: i.zero?, class: "sr-only", id: "message_role_#{value}_#{posting.id}",
                data: { placeholder: placeholders[value], action: "composer#switch" } %><%= label %>
        </label>
      <% end %>
    </div>
    <%= f.text_area :body, rows: 4, required: true, disabled: replying, class: "textarea !mt-0 [field-sizing:content] max-h-80",
          "aria-label": "Message", placeholder: placeholders["client"], data: { composer_target: "body" } %>
    <div class="flex flex-wrap items-center gap-3">
      <%= f.text_field :note, disabled: replying, class: "input !mt-0 min-w-0 flex-1 group-has-[[value=ask]:checked]/composer:hidden",
            placeholder: "Optional note: push for a call, quote $45/hr…", "aria-label": "Note for this reply" %>
      <%= f.button disabled: replying, class: "btn btn-primary ml-auto", data: { turbo_submits_with: "Sending…" } do %>
        <%= icon(:send) %>
        <span class="group-has-[[value=ask]:checked]/composer:hidden">Draft my reply</span>
        <span class="hidden group-has-[[value=ask]:checked]/composer:inline">Ask Radar</span>
      <% end %>
    </div>
  <% end %>
</section>
