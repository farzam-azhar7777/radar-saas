<%= form_with model: @search, class: "panel panel-pad max-w-[46rem] space-y-5" do |f| %>
  <% if @search.errors.any? %>
    <div class="notice notice-signal"><%= @search.errors.full_messages.to_sentence %></div>
  <% end %>
  <div>
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, class: "input", required: true %>
  </div>
  <div>
    <%= f.label :terms_text, "Words a client would use", class: "field-label" %>
    <%= f.text_area :terms_text, value: @search.terms_list.join(", "), rows: 2, class: "textarea !min-h-0" %>
    <p class="field-hint">Separated by commas. Phrases are matched as phrases.</p>
  </div>
  <div>
    <%= f.label :excluded_keywords_text, "Words that rule a job out", class: "field-label" %>
    <%= f.text_area :excluded_keywords_text, value: @search.excluded_keywords_list.join(", "), rows: 2, class: "textarea !min-h-0" %>
  </div>
  <div class="grid gap-5 sm:grid-cols-3">
    <div>
      <%= f.label :threshold, "Inbox at", class: "field-label" %>
      <%= f.number_field :threshold, min: 0, max: 100, class: "input tnum" %>
      <p class="field-hint">Shows in your inbox.</p>
    </div>
    <div>
      <%= f.label :hot_threshold, "Alert me at", class: "field-label" %>
      <%= f.number_field :hot_threshold, min: 0, max: 100, class: "input tnum" %>
      <p class="field-hint">Interrupts you.</p>
    </div>
    <div>
      <%= f.label :min_hourly, "Lowest hourly rate", class: "field-label" %>
      <%= f.number_field :min_hourly, step: 1, class: "input tnum" %>
    </div>
  </div>
  <div>
    <%= f.label :template_name, "Proposal shape", class: "field-label" %>
    <%= f.select :template_name, CareerData.instance.templates.map { |t| [ t.tr("-", " ").capitalize, t ] }, { include_blank: "No template" }, class: "select" %>
  </div>
  <div class="space-y-3 border-t border-rule pt-5">
    <label class="flex cursor-pointer items-start gap-3 text-[0.875rem]">
      <%= f.check_box :auto_generate, class: "check mt-0.5" %>
      <span><span class="font-semibold">Write the proposal automatically</span>
        <span class="hint block">On: a strong match is written the moment it arrives. Off: Radar alerts you and waits.</span></span>
    </label>
    <label class="flex cursor-pointer items-center gap-3 text-[0.875rem]"><%= f.check_box :active, class: "check" %> <span class="font-semibold">Active</span></label>
  </div>
  <div class="flex flex-wrap items-center gap-3 pt-1">
    <%= f.submit "Save search", class: "btn btn-primary" %>
    <%= link_to "Cancel", saved_searches_path, class: "btn btn-ghost" %>
    <% if @search.persisted? %>
      <%= button_to "Delete", saved_search_path(@search), method: :delete, form: { class: "ml-auto", data: { turbo_confirm: "Delete this search? Jobs it found stay." } }, class: "btn btn-danger btn-sm" %>
    <% end %>
  </div>
<% end %>
