<% content_for :title, "Searches - Radar" %>
<div class="flex flex-wrap items-end gap-4">
  <div class="min-w-0 flex-1">
    <h1 class="title">Searches</h1>
    <p class="lede mt-1">What Radar looks for on Upwork. Each search is queried on its own, so a broad one cannot bury the jobs a narrow one finds.</p>
  </div>
  <%= link_to new_saved_search_path, class: "btn btn-primary" do %><%= icon(:plus) %> Add a search<% end %>
</div>

<%= render "job_limits/panel", limits: @limits, impact: @impact %>

<div data-controller="bulk">
  <% if @searches.any? %>
    <%= form_with url: bulk_saved_searches_path, id: "bulk-form", class: "panel mt-6 flex flex-wrap items-end gap-x-4 gap-y-3 px-5 py-4" do %>
      <label class="flex items-center gap-2.5 self-center text-[0.8125rem] font-semibold">
        <input type="checkbox" class="check" data-bulk-target="all" data-action="bulk#toggleAll">
        <span data-bulk-target="count">None selected</span>
      </label>
      <div>
        <label class="field-label" for="bulk_auto_generate">Write automatically</label>
        <%= select_tag "bulk[auto_generate]", options_for_select([ [ "Leave as is", "" ], [ "On", "on" ], [ "Off", "off" ] ]), id: "bulk_auto_generate", class: "select !w-auto" %>
      </div>
      <div>
        <label class="field-label" for="bulk_active">Active</label>
        <%= select_tag "bulk[active]", options_for_select([ [ "Leave as is", "" ], [ "Active", "on" ], [ "Paused", "off" ] ]), id: "bulk_active", class: "select !w-auto" %>
      </div>
      <div>
        <label class="field-label" for="bulk_threshold">Inbox at</label>
        <%= number_field_tag "bulk[threshold]", nil, id: "bulk_threshold", min: 0, max: 100, placeholder: "as is", class: "input tnum !w-24" %>
      </div>
      <div>
        <label class="field-label" for="bulk_hot_threshold">Alert at</label>
        <%= number_field_tag "bulk[hot_threshold]", nil, id: "bulk_hot_threshold", min: 0, max: 100, placeholder: "as is", class: "input tnum !w-24" %>
      </div>
      <button class="btn btn-secondary" data-bulk-target="apply" disabled>Apply to selected</button>
    <% end %>
  <% end %>

  <div class="panel mt-4 divide-y divide-rule overflow-hidden">
    <% @searches.each do |s| %>
      <div data-controller="reveal">
        <div class="grid gap-x-6 gap-y-3 px-5 py-4 md:grid-cols-[auto_1fr_10rem_13rem_auto] md:items-center <%= 'opacity-70' unless s.active? %>">
          <input type="checkbox" name="ids[]" value="<%= s.id %>" form="bulk-form" class="check" aria-label="Select <%= s.name %>"
                 data-bulk-target="item" data-action="bulk#update">
          <div class="min-w-0">
            <p class="font-semibold"><%= s.name %></p>
            <div class="mt-2 flex flex-wrap gap-1.5"><% s.terms_list.each do |t| %><span class="chip chip-outline"><%= t %></span><% end %></div>
            <% if s.excluded_keywords_list.any? %><p class="mt-2 text-[0.8125rem] text-faint">Never: <%= s.excluded_keywords_list.join(", ") %></p><% end %>
          </div>
          <div class="text-[0.8125rem] tnum">
            <p><span class="text-muted">Inbox at</span> <span class="font-semibold"><%= s.threshold %></span></p>
            <p><span class="text-muted">Alert at</span> <span class="font-semibold text-signal"><%= s.hot_threshold %></span></p>
            <p class="text-faint"><%= pluralize(s.job_postings.count, "job") %> found</p>
          </div>
          <div class="space-y-2.5">
            <%= render "saved_searches/toggle", search: s, field: "auto_generate", on: s.auto_generate?, label: "Write automatically",
                       hint: "Write the proposal as soon as a strong match arrives. Off: it only alerts you." %>
            <%= render "saved_searches/toggle", search: s, field: "active", on: s.active?, label: "Active",
                       hint: "Search Upwork with this. Off: paused, nothing new arrives from it." %>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" data-action="reveal#toggle" data-reveal-target="toggle" aria-expanded="false">
            <%= icon(:pen) %> Edit
          </button>
        </div>
        <div class="border-t border-rule bg-sunk px-5 py-5" data-reveal-target="panel" hidden>
          <%= render "saved_searches/form", search: s, namespace: "search_#{s.id}" %>
        </div>
      </div>
    <% end %>
    <% if @searches.none? %>
      <div class="px-8 py-12 text-center"><p class="heading">No searches</p><p class="hint mt-1">Radar looks for nothing until you add one.</p></div>
    <% end %>
  </div>
</div>
