<% check = (JSON.parse(Setting.get("setup.claude_check", "{}")) rescue {}) %>
<% done = Onboarding.done?("claude") %>
<div class="max-w-[46rem] space-y-6">
  <div class="panel panel-pad">
    <div class="flex items-start gap-4">
      <span class="grid h-10 w-10 flex-none place-items-center rounded-[10px] <%= done ? 'bg-brand-soft text-brand' : 'bg-sunk text-muted' %>"><%= icon(:terminal, css: "h-5 w-5") %></span>
      <div class="min-w-0 flex-1">
        <p class="font-semibold">
          <% if done %>Claude Code is working
          <% elsif check.empty? %>Not checked yet
          <% else %>Claude Code needs attention<% end %>
        </p>
        <p class="hint mt-0.5">Radar runs <code class="rounded bg-sunk px-1.5 py-0.5 text-[0.8rem] text-ink"><%= @claude_command %></code><%= ", version #{check['version'].to_s.sub(' (Claude Code)', '')}" if check["version"].present? %>. Proposals are written with <%= @writer_model || "your plan's default model" %>.</p>
      </div>
    </div>

    <% if check.present? && !done %>
      <div class="mt-5 border-t border-rule pt-5">
        <% if check["fix"] == "install" %>
          <p class="font-semibold">Radar could not run <%= @claude_command %> on this computer.</p>
          <ol class="mt-3 list-decimal space-y-2 pl-5 text-[0.9rem]">
            <li>Install Claude Code: in a terminal, run <code class="rounded bg-sunk px-1.5 py-0.5 text-[0.8rem]">npm install -g @anthropic-ai/claude-code</code></li>
            <li>Run <code class="rounded bg-sunk px-1.5 py-0.5 text-[0.8rem]">claude</code> once and sign in.</li>
            <li>Already installed? Run <code class="rounded bg-sunk px-1.5 py-0.5 text-[0.8rem]">which claude</code> and paste the path below.</li>
          </ol>
        <% elsif check["fix"] == "login" %>
          <p class="font-semibold">Claude Code is installed but not signed in.</p>
          <p class="hint mt-1">In a terminal, run <code class="rounded bg-sunk px-1.5 py-0.5 text-[0.8rem] text-ink">claude</code>, sign in with the Claude account you want proposals written on, then check again.</p>
        <% elsif check["fix"] == "model" %>
          <p class="font-semibold">Your Claude plan cannot use <%= Radar::DEFAULT_WRITER_MODEL %>.</p>
          <p class="hint mt-1">It is the model Radar's proposals were tuned on. Your plan's default model still writes good proposals; they may be a little less sharp.</p>
          <%= button_to "Write with my plan's default model", setup_claude_model_path, method: :patch, params: { model: "default" },
                class: "btn btn-secondary mt-3" %>
        <% else %>
          <p class="font-semibold">The check failed.</p>
        <% end %>
        <% if check["error"].present? %>
          <details class="mt-3">
            <summary class="cursor-pointer text-[0.8125rem] text-muted">What it said</summary>
            <pre class="mt-2 whitespace-pre-wrap rounded-[10px] bg-sunk p-3 text-[0.78rem] text-muted"><%= check["error"] %></pre>
          </details>
        <% end %>
      </div>
    <% end %>
  </div>

  <details class="group" <%= "open" if check["fix"] == "install" %>>
    <summary class="cursor-pointer text-[0.875rem] font-semibold text-muted hover:text-ink">Claude is installed somewhere unusual</summary>
    <%= form_with url: setup_claude_path_path, method: :patch, class: "mt-3 flex flex-col gap-3 sm:flex-row sm:items-end" do %>
      <div class="flex-1">
        <label for="claude_path" class="field-label">Full path to claude</label>
        <input id="claude_path" name="claude_path" class="input" placeholder="/Users/you/.local/bin/claude" value="<%= Setting.get(Setting::CLAUDE_PATH) %>" autocomplete="off">
        <p class="field-hint">Leave empty to use whatever <code>claude</code> is on the PATH Radar was started with.</p>
      </div>
      <button class="btn btn-secondary sm:mb-[1.55rem]">Save path</button>
    <% end %>
    <% if Setting.get(Setting::WRITER_MODEL) == "default" %>
      <%= button_to "Go back to writing with #{Radar::DEFAULT_WRITER_MODEL}", setup_claude_model_path, method: :patch,
            params: { model: "pinned" }, class: "btn btn-ghost btn-sm mt-3" %>
    <% end %>
  </details>
</div>

<% primary = if done
     button_to "Continue", setup_continue_path("claude"), class: "btn btn-primary btn-lg"
   else
     button_to (check.empty? ? "Check Claude Code" : "Check again"), setup_claude_check_path,
       class: "btn btn-primary btn-lg", data: { turbo_submits_with: "Checking, about 20 seconds…" }
   end %>
<%= render "setup/steps/footer", step: @step, primary: primary %>
