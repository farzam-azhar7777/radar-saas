<% posting = @posting %>
<% checked_at = (Time.zone.parse(Setting.get("setup.first_check_at").to_s) rescue nil) %>
<% checking = posting.nil? && checked_at && checked_at > 90.seconds.ago && @candidates.none? %>
<% writing = posting&.generating? %>
<% proposal = posting&.latest_proposal %>
<div class="max-w-[46rem] space-y-8" <%= "data-controller=autorefresh data-autorefresh-every-value=4000" if checking || writing %>>
  <% if Knowledge::Project.in_flight.exists? %>
    <div class="notice notice-warn">
      <%= icon(:alert, css: "mt-0.5 h-4 w-4 flex-none") %>
      <div><%= pluralize(Knowledge::Project.in_flight.count, "project") %> still being written up. A proposal written now cannot cite them yet; you can wait, or go ahead.</div>
    </div>
  <% elsif Knowledge::Project.drafted.exists? %>
    <div class="notice notice-warn">
      <%= icon(:alert, css: "mt-0.5 h-4 w-4 flex-none") %>
      <div><%= pluralize(Knowledge::Project.drafted.count, "write-up") %> waiting for you in <%= link_to "Your work", setup_step_path("knowledge"), class: "link" %>. Proposals only cite projects you accepted.</div>
    </div>
  <% end %>

  <% if posting.nil? %>
    <% if @candidates.any? %>
      <section>
        <h2 class="heading">Pick a job to write for</h2>
        <p class="hint mt-1">Open jobs your searches just found, best fit first.</p>
        <ul class="panel mt-4 divide-y divide-rule">
          <% @candidates.each do |job| %>
            <li class="flex items-center gap-4 px-4 py-3.5">
              <span class="dial <%= dial_class(job.score) %>" style="--pct: <%= job.score.to_i %>"><span><%= job.score %></span></span>
              <div class="min-w-0 flex-1">
                <p class="truncate font-semibold"><%= job.title %></p>
                <p class="mt-0.5 flex flex-wrap gap-x-3 text-[0.8125rem] text-muted">
                  <span><%= job.budget_label %></span><span><%= job.pressure_label %></span><span><%= job.age_label %></span>
                  <% if job.saved_search %><span><%= job.saved_search.name %></span><% end %>
                </p>
              </div>
              <%= button_to "Write for this", setup_first_proposal_pick_path(job), class: "btn btn-secondary btn-sm", data: { turbo_submits_with: "Starting…" } %>
            </li>
          <% end %>
        </ul>
      </section>
    <% elsif checking %>
      <div class="panel panel-pad flex items-center gap-3">
        <span class="ping"></span>
        <p>Checking Upwork with your searches. Matches appear here as they come in.</p>
      </div>
    <% elsif checked_at %>
      <div class="notice notice-info">
        <div>
          <p class="font-semibold">No open job clears your searches right now</p>
          <p class="mt-1 text-muted">That can simply mean a quiet hour. Check again, lower a search's "Inbox at" in <%= link_to "Searches", setup_step_path("searches"), class: "link" %>, or paste any job below.</p>
        </div>
      </div>
    <% else %>
      <div class="panel panel-pad">
        <p>Radar runs your searches against Upwork now, scores what comes back, and lists the best matches. Pick one and it writes the proposal while you watch.</p>
      </div>
    <% end %>

    <details <%= "open" if checked_at && @candidates.none? && !checking %>>
      <summary class="cursor-pointer text-[0.875rem] font-semibold text-muted hover:text-ink">Or paste a job post</summary>
      <%= form_with url: setup_first_proposal_paste_path, class: "mt-3 space-y-4" do %>
        <div><label class="field-label" for="job_title">Job title</label><input id="job_title" name="title" class="input" required></div>
        <div><label class="field-label" for="job_description">Full description</label><textarea id="job_description" name="description" rows="8" class="textarea" required></textarea></div>
        <div>
          <label class="field-label" for="job_questions">Screening questions, one per line</label>
          <textarea id="job_questions" name="questions" rows="3" class="textarea !min-h-0"></textarea>
          <p class="field-hint">Only if the job has them.</p>
        </div>
        <button class="btn btn-secondary">Write for this job</button>
      <% end %>
    </details>

  <% else %>
    <section>
      <p class="hint">Writing for</p>
      <p class="heading mt-0.5"><%= posting.title %></p>
      <p class="mt-1 flex flex-wrap gap-x-3 text-[0.8125rem] text-muted">
        <span><%= posting.budget_label %></span>
        <% if posting.upwork_id.start_with?("pasted-") %><span>Pasted by you</span><% else %><span><%= posting.pressure_label %></span><% end %>
      </p>
    </section>

    <% if writing %>
      <div class="panel panel-pad" data-controller="generation"
           data-generation-started-at-value="<%= (posting.generation_queued_at.to_f * 1000).round %>"
           data-generation-typical-value="<%= Radar.typical_generation_seconds %>"
           data-generation-timeout-value="<%= Radar.generation_timeout %>">
        <div class="flex items-center gap-3">
          <span class="ping"></span>
          <p class="font-semibold"><%= proposal ? "Rewriting with your note" : "Writing your proposal" %></p>
          <span class="ml-auto text-[0.8125rem] tnum text-muted" data-generation-target="elapsed"><%= posting.generating_for.to_i %>s</span>
        </div>
        <div class="meter mt-4"><i style="width: 2%; background: var(--color-brand)" data-generation-target="bar"></i></div>
        <p class="hint mt-3" data-generation-target="note">Reading the post, your projects and the writing rules.</p>
        <p class="hint mt-1">Usually two to four minutes. You can leave this page; it carries on.</p>
      </div>
    <% elsif posting.status == "generation_failed" %>
      <div class="notice notice-signal">
        <div>
          <p class="font-semibold">Writing failed</p>
          <p class="mt-1"><%= posting.generation_error.to_s.truncate(400) %></p>
          <%= button_to "Try again", setup_first_proposal_pick_path(posting), class: "btn btn-secondary btn-sm mt-3" %>
        </div>
      </div>
    <% end %>

    <% if proposal&.body.present? && !writing %>
      <section>
        <div class="well px-4 py-3">
          <p class="hint">What the client sees in their list, before they click</p>
          <p class="mt-1 text-[0.9rem]"><%= proposal.preview %><span class="text-faint"> … View more</span></p>
        </div>
        <div class="panel mt-4">
          <% proposal.ensure_sections!.each do |part| %>
            <div class="border-b border-rule px-5 py-4 last:border-0">
              <p class="text-[0.8125rem] font-semibold text-muted"><%= part.answer? ? "Screening answer" : part.display_label %></p>
              <p class="mt-1.5 whitespace-pre-wrap text-[0.9rem] leading-relaxed"><%= part.body %></p>
            </div>
          <% end %>
        </div>
        <% if proposal.to_fix.any? %>
          <div class="notice notice-warn mt-4"><div><p class="font-semibold">Radar would fix before sending</p><ul class="mt-1 list-disc pl-5"><% proposal.to_fix.each do |f| %><li><%= f %></li><% end %></ul></div></div>
        <% end %>
      </section>

      <section class="panel panel-pad" data-controller="reveal">
        <p class="heading">Would you send this?</p>
        <p class="hint mt-1">Honestly. Setup finishes when the answer is yes; until then, say what is wrong and Radar rewrites it.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <%= button_to "Yes, I would send it", setup_first_proposal_verdict_path, params: { send: "yes" }, class: "btn btn-primary" %>
          <button type="button" class="btn btn-secondary" data-action="reveal#toggle" data-reveal-target="toggle">Not yet</button>
          <span class="ml-auto" data-controller="clipboard" data-clipboard-text-value="<%= proposal.cover_letter_text %>">
            <button type="button" class="btn btn-ghost" data-action="clipboard#copy" data-clipboard-target="button"><%= icon(:copy) %> <span>Copy cover letter</span></button>
          </span>
        </div>
        <div data-reveal-target="panel" hidden class="mt-4">
          <%= form_with url: setup_first_proposal_verdict_path do %>
            <input type="hidden" name="send" value="no">
            <label class="field-label" for="verdict_feedback">What is wrong with it</label>
            <textarea id="verdict_feedback" name="feedback" rows="3" class="textarea" required placeholder="Lead with a different project. Too long. It does not sound like me."></textarea>
            <label class="mt-3 flex cursor-pointer items-start gap-2.5 text-[0.875rem]">
              <input type="checkbox" name="remember" value="1" class="check mt-0.5" checked>
              <span>Remember this for every future proposal, not just this one</span>
            </label>
            <button class="btn btn-secondary mt-4">Rewrite it</button>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>

<% primary = if posting.nil?
     button_to((checked_at ? "Check again" : "Check Upwork now"), setup_first_proposal_check_path, class: "btn btn-primary btn-lg", data: { turbo_submits_with: "Checking…" })
   elsif !writing && !proposal&.body.present?
     button_to "Pick another job", setup_first_proposal_check_path, class: "btn btn-secondary btn-lg"
   end %>
<%= render "setup/steps/footer", step: @step, primary: primary.to_s.html_safe %>
