<% state = @suggest_state %>
<% running = SearchSuggester.running? %>
<% fresh = @suggestions.reject { |s| @taken.include?(s.name.to_s.downcase) } %>
<div class="max-w-[46rem] space-y-10" <%= "data-controller=autorefresh data-autorefresh-every-value=4000" if running %>>
  <% if @searches.any? %>
    <section>
      <h2 class="heading">Watching for</h2>
      <ul class="panel mt-3 divide-y divide-rule">
        <% @searches.each do |s| %>
          <li class="px-4 py-3.5">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-semibold"><%= s.name %></p>
              <% if s.auto_generate? %><span class="chip chip-good">Writes automatically</span><% else %><span class="chip">Alerts only</span><% end %>
              <span class="text-[0.8125rem] tnum text-muted">inbox at <%= s.threshold %>, alert at <%= s.hot_threshold %></span>
              <%= button_to "Remove", setup_search_path(s), method: :delete, class: "btn btn-ghost btn-sm", form: { class: "ml-auto" } %>
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5"><% s.terms_list.each do |t| %><span class="chip"><%= t %></span><% end %></div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section>
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="heading">Suggested from your work</h2>
      <% if state["status"] == "ready" %>
        <%= button_to "Suggest again", setup_searches_suggest_path, class: "btn btn-ghost btn-sm", form: { class: "ml-auto" } %>
      <% end %>
    </div>

    <% if running %>
      <div class="panel panel-pad mt-3 flex items-center gap-3">
        <span class="ping"></span>
        <p>Reading your profile and projects. About a minute.</p>
      </div>
    <% elsif state["status"] == "failed" %>
      <div class="notice notice-warn mt-3">
        <div>
          <p>Radar could not suggest searches this time: <%= state["error"] %></p>
          <%= button_to "Try again", setup_searches_suggest_path, class: "btn btn-secondary btn-sm mt-2" %>
        </div>
      </div>
    <% elsif state["status"] != "ready" %>
      <div class="panel panel-pad mt-3">
        <p>Radar reads your skills and projects and proposes searches for the work you are best at, each with its reason. You change or drop any of them.</p>
        <%= button_to setup_searches_suggest_path, class: "btn #{@searches.none? ? 'btn-primary' : 'btn-secondary'} mt-4" do %><%= icon(:spark) %> Suggest searches<% end %>
      </div>
    <% elsif fresh.empty? %>
      <p class="hint mt-2">You have added every suggestion.</p>
    <% end %>

    <% if state["status"] == "ready" %>
      <div class="mt-4 space-y-4">
        <% fresh.each_with_index do |s, i| %>
          <details id="suggestion-<%= s.name.parameterize %>" class="panel group" <%= "open" if i.zero? %>>
            <summary class="flex cursor-pointer items-start gap-3 px-5 py-4">
              <div class="min-w-0 flex-1">
                <p class="font-semibold"><%= s.name %> <% if s.auto_generate %><span class="chip chip-good ml-1 align-middle">Writes automatically</span><% end %></p>
                <p class="hint mt-0.5"><%= s.reason %></p>
              </div>
              <span class="text-[0.8125rem] text-muted group-open:hidden">Review</span>
            </summary>
            <div class="border-t border-rule px-5 py-5">
              <%= render "setup/searches/form", s: s, key: "s#{i}" %>
            </div>
          </details>
        <% end %>
      </div>
    <% end %>
  </section>

  <section>
    <details id="common-searches">
      <summary class="cursor-pointer text-[0.875rem] font-semibold text-muted hover:text-ink">Start from a common search</summary>
      <div class="mt-3 space-y-3">
        <% @presets.reject { |p| @taken.include?(p.name.downcase) }.each_with_index do |p, i| %>
          <details id="preset-<%= p.name.parameterize %>" class="panel">
            <summary class="cursor-pointer px-4 py-3 font-semibold"><%= p.name %> <span class="ml-2 text-[0.8125rem] font-normal text-muted"><%= p.terms.first(3).join(", ") %></span></summary>
            <div class="border-t border-rule px-4 py-4"><%= render "setup/searches/form", s: p, key: "p#{i}" %></div>
          </details>
        <% end %>
      </div>
    </details>
    <details id="own-search" class="mt-4">
      <summary class="cursor-pointer text-[0.875rem] font-semibold text-muted hover:text-ink">Write your own</summary>
      <div class="panel panel-pad mt-3"><%= render "setup/searches/form", s: nil, key: "own" %></div>
    </details>
  </section>
</div>

<% primary = if Onboarding.done?("searches")
     button_to "Continue", setup_continue_path("searches"), class: "btn btn-primary btn-lg"
   else
     tag.button("Continue", class: "btn btn-primary btn-lg", disabled: true, title: "Add at least one search")
   end %>
<%= render "setup/steps/footer", step: @step, primary: primary %>
