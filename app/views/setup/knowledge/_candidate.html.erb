<% repos = project.repos.to_a %>
<li id="project-<%= project.id %>" class="<%= 'bg-surface/60' unless project.included %>">
  <div class="flex items-start gap-3.5 px-4 py-3.5">
    <%= button_to setup_knowledge_toggle_path(project), class: "mt-0.5 grid h-5 w-5 flex-none place-items-center rounded-[5px] border-[1.5px] #{project.included ? 'border-brand bg-brand text-on-brand' : 'border-rule-strong bg-paper'}",
          "aria-pressed": project.included, title: project.included ? "Chosen. Click to leave it for now." : "Choose this project" do %>
      <% if project.included %><%= icon(:check, css: "h-3.5 w-3.5") %><% end %>
      <span class="sr-only"><%= project.included ? "Chosen" : "Not chosen" %>: <%= project.name %></span>
    <% end %>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <p class="font-semibold <%= 'text-muted' unless project.included %>"><%= project.name %></p>
        <% if project.client.present? %><span class="text-[0.8125rem] text-muted">for <%= project.client %></span><% end %>
      </div>
      <p class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-[0.8125rem] tnum text-muted">
        <span><strong class="font-semibold text-ink"><%= number_label(project.own_commits) %></strong> of <%= number_label(project.total_commits) %> commits yours</span>
        <% if project.span_label %><span><%= project.span_label %></span><% end %>
        <span><%= repos.map(&:name).join(", ") %></span>
      </p>
      <% if (stack = project.stack_names.first(7)).any? %>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% stack.each do |s| %><span class="chip"><%= s %></span><% end %>
        </div>
      <% end %>

      <details class="mt-2">
        <summary class="cursor-pointer text-[0.8125rem] font-semibold text-muted hover:text-ink">Rename, merge or split</summary>
        <div class="mt-3 space-y-4">
          <%= form_with url: setup_knowledge_project_path(project), method: :patch, scope: :project, class: "grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |f| %>
            <div>
              <%= f.label :name, "What clients call it", class: "field-label text-[0.8125rem]", for: "name-#{project.id}" %>
              <%= f.text_field :name, value: project.name, id: "name-#{project.id}", class: "input !py-1.5" %>
            </div>
            <div>
              <%= f.label :client, "Client, if you can say", class: "field-label text-[0.8125rem]", for: "client-#{project.id}" %>
              <%= f.text_field :client, value: project.client, id: "client-#{project.id}", class: "input !py-1.5" %>
            </div>
            <button class="btn btn-secondary btn-sm mb-[3px]">Save</button>
          <% end %>

          <% others = candidates.reject { |c| c.id == project.id } %>
          <% if others.any? %>
            <%= form_with url: setup_knowledge_merge_path, class: "flex flex-wrap items-end gap-3" do %>
              <input type="hidden" name="ids[]" value="<%= project.id %>">
              <div class="min-w-[14rem] flex-1">
                <label class="field-label text-[0.8125rem]" for="merge-<%= project.id %>">It is the same product as</label>
                <select name="ids[]" id="merge-<%= project.id %>" class="select !py-1.5">
                  <% others.first(80).each do |o| %><option value="<%= o.id %>"><%= o.name %></option><% end %>
                </select>
              </div>
              <button class="btn btn-secondary btn-sm mb-[3px]"><%= icon(:merge) %> Merge</button>
            <% end %>
          <% end %>

          <% if repos.size > 1 %>
            <div>
              <p class="field-label text-[0.8125rem]">Repositories</p>
              <ul class="mt-1.5 space-y-1">
                <% repos.each do |repo| %>
                  <li class="flex items-center gap-3 text-[0.8125rem]">
                    <span class="flex-1 truncate"><%= repo.relative_path %> <span class="tnum text-muted">(<%= number_label(repo.own_commits) %> yours)</span></span>
                    <%= button_to setup_knowledge_split_path(project, repo_id: repo.id), class: "btn btn-ghost btn-sm" do %><%= icon(:split) %> Separate<% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if (readme = repos.filter_map(&:readme_head).first) %>
            <div>
              <p class="field-label text-[0.8125rem]">From its README</p>
              <p class="mt-1 line-clamp-4 whitespace-pre-line text-[0.8125rem] text-muted"><%= readme.truncate(500) %></p>
            </div>
          <% end %>

          <%= button_to "Leave this out", setup_knowledge_exclude_path(project), class: "btn btn-ghost btn-sm",
                title: "It will not be offered again, even after a rescan." %>
        </div>
      </details>
    </div>

    <div class="hidden text-right sm:block" title="How strongly Radar would pitch this, from your history">
      <span class="dial <%= project.rank_score >= 70 ? 'dial-good' : 'dial-fair' %>" style="--pct: <%= project.rank_score.round %>"><span><%= project.rank_score.round %></span></span>
    </div>
  </div>
</li>
