<% content_for :title, "#{@posting.title.truncate(60)} - Radar" %>
<%= turbo_stream_from "job_posting_#{@posting.id}" %>

<%= link_to root_path, class: "inline-flex items-center gap-1 text-[0.8125rem] font-semibold text-muted hover:text-ink" do %><%= icon(:back) %> Inbox<% end %>

<div class="mt-3 flex flex-wrap items-start gap-5">
  <span class="dial dial-lg <%= dial_class(@posting.score) %>" style="--pct: <%= @posting.score.to_i %>" title="Fit <%= @posting.score %> of 100"><span><%= @posting.score %></span></span>
  <%# A floor on the title's width, so on a phone the actions wrap below it
      instead of squeezing it to one word a line. %>
  <div class="min-w-[min(100%,15rem)] flex-1">
    <h1 class="title text-balance"><%= @posting.title %></h1>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[0.875rem] text-muted">
      <span class="font-semibold text-ink"><%= @posting.budget_label %></span>
      <% if @posting.engagement.present? %><span><%= @posting.engagement %></span><% end %>
      <% if @posting.duration_label.present? %><span><%= @posting.duration_label %></span><% end %>
      <% if @posting.saved_search %><span><%= @posting.saved_search.name %></span><% end %>
      <span>posted <%= @posting.age_label %></span>
    </p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <div class="mr-2 text-right">
      <p class="font-display text-[1.05rem] font-semibold tnum <%= @posting.total_applicants.to_i >= 30 ? 'text-signal' : '' %>"><%= @posting.pressure_label %></p>
      <p class="text-[0.75rem] text-faint">
        <% if @posting.applicants_at_discovery.present? && @posting.applicants_at_discovery != @posting.total_applicants %>
          was <%= @posting.applicants_at_discovery %> when found,
        <% end %>
        <%= @posting.refreshed_at ? "checked #{time_ago_in_words(@posting.refreshed_at)} ago" : "not re-checked" %>
      </p>
    </div>
    <%= button_to refresh_job_posting_path(@posting), class: "btn btn-secondary btn-sm",
          title: "Re-check the live bid count and client stats on Upwork. One API call." do %><%= icon(:refresh) %> Refresh<% end %>
    <%= link_to @posting.upwork_url, target: "_blank", rel: "noopener", class: "btn btn-secondary btn-sm" do %>Open on Upwork <%= icon(:external) %><% end %>
  </div>
</div>

<div class="mt-6"><%= render "job_postings/client", posting: @posting %></div>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
  <div class="space-y-5">
    <section class="panel panel-pad">
      <h2 class="heading">The post</h2>
      <div class="mt-3 whitespace-pre-wrap text-[0.9rem] leading-relaxed" style="max-width: 70ch"><%= @posting.description %></div>
      <% if @posting.skills.present? %>
        <div class="mt-4 flex flex-wrap gap-1.5"><% Array(@posting.skills).each do |s| %><span class="chip"><%= s %></span><% end %></div>
      <% end %>
    </section>

    <% if @posting.screening_questions_list.any? %>
      <section class="panel panel-pad">
        <h2 class="heading">Screening questions</h2>
        <p class="hint">Answered in the proposal, each in its own box on Upwork.</p>
        <ol class="mt-3 space-y-2.5">
          <% @posting.screening_questions_list.each_with_index do |q, i| %>
            <li class="flex gap-3 text-[0.875rem] leading-relaxed"><span class="step-mark !h-6 !w-6 !text-[0.7rem]"><%= i + 1 %></span><span><%= q %></span></li>
          <% end %>
        </ol>
      </section>
    <% end %>

    <section class="panel panel-pad">
      <h2 class="heading">Why it scored <%= @posting.score %></h2>
      <div class="mt-4 space-y-4">
        <% Array(@posting.score_reasons).each do |r| %>
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[0.875rem] font-semibold"><%= r["key"].to_s.tr("_", " ").capitalize %></span>
              <span class="text-[0.8125rem] tnum text-muted"><%= r["points"] %> of <%= r["max"] %></span>
            </div>
            <div class="meter mt-1.5"><i style="width: <%= r['max'].to_i.zero? ? 0 : (r['points'].to_f / r['max'] * 100).round %>%"></i></div>
            <p class="mt-1 text-[0.8125rem] text-muted"><%= r["note"] %></p>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <div class="space-y-5">
    <section class="panel panel-pad">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="heading">How Radar will pitch this</h2>
        <span class="chip chip-outline">Shape <%= @archetype.label %></span>
      </div>
      <% shape = @archetype.call %>
      <p class="mt-2 text-[0.875rem]"><%= shape[:name] %>. A letter of <%= shape[:words].min %> to <%= shape[:words].max %> words<%= ", with answers counted separately" if shape[:has_questions] %>.</p>
      <ul class="mt-2 space-y-1 text-[0.8125rem] text-muted"><% shape[:signals].each do |s| %><li><%= s %></li><% end %></ul>
      <% if @lessons.any? %>
        <details class="mt-4 border-t border-rule pt-3">
          <summary class="cursor-pointer text-[0.8125rem] font-semibold text-muted hover:text-ink"><%= pluralize(@lessons.size, "rule") %> from your feedback apply here</summary>
          <ul class="mt-2 space-y-1.5">
            <% @lessons.each do |l| %><li class="text-[0.8125rem] leading-relaxed text-muted"><span class="font-semibold text-ink"><%= l.scope_label %>:</span> <%= l.body %></li><% end %>
          </ul>
        </details>
      <% end %>
    </section>

    <div id="proposal-pane"><%= render "job_postings/proposal_pane", posting: @posting %></div>
  </div>
</div>
