<%# path is the page being filtered; everything round-trips through the query string. %>
<div class="mt-5 flex flex-wrap items-center gap-3">
  <%= form_with url: path, method: :get, class: "relative min-w-[16rem] flex-1 sm:max-w-sm" do %>
    <%= hidden_field_tag :sort, @sort %>
    <%= hidden_field_tag :search, params[:search] if params[:search].present? %>
    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-faint"><%= icon(:search) %></span>
    <%= search_field_tag :q, @query, placeholder: "Search titles, skills, countries", autocomplete: "off", "aria-label": "Search jobs",
          class: "input !mt-0 !py-2 pl-9" %>
  <% end %>

  <div class="flex items-center gap-1 rounded-[10px] bg-sunk p-1" role="group" aria-label="Sort">
    <% JobPosting::SORTS.each do |key, (label, _)| %>
      <%= link_to label, url_for(sort: key, q: @query.presence, search: params[:search]),
            class: "rounded-[7px] px-2.5 py-1 text-[0.8125rem] font-semibold #{@sort == key ? 'bg-paper text-ink shadow-sm' : 'text-muted hover:text-ink'}",
            "aria-current": (@sort == key ? "true" : nil) %>
    <% end %>
  </div>
</div>

<% if @searches.size > 1 %>
  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    <%= link_to "All searches", url_for(sort: @sort, q: @query.presence),
          class: "chip #{params[:search].blank? ? 'chip-good' : 'chip-outline hover:bg-sunk'}" %>
    <% @searches.each do |s| %>
      <%= link_to s.name, url_for(sort: @sort, q: @query.presence, search: s.id),
            class: "chip #{params[:search].to_s == s.id.to_s ? 'chip-good' : 'chip-outline hover:bg-sunk'}" %>
    <% end %>
  </div>
<% end %>
