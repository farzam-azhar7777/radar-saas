#!/usr/bin/env ruby
# First run and every run after it: installs what Radar needs, prepares the
# databases, and starts it. Safe to run again at any time.
#
#   bin/setup                 install, then start Radar
#   bin/setup --skip-server   install only
#   bin/setup --reset         start over with empty databases (keeps your repos untouched)
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
PORT = ENV.fetch("PORT", "8586")

def system!(*args)
  system(*args, exception: true)
end

def say(text) = puts("\n== #{text} ==")

def found?(command) = system("command -v #{command} > /dev/null 2>&1")

FileUtils.chdir APP_ROOT do
  say "Checking what Radar runs on"
  required_ruby = File.read(".ruby-version").strip.delete_prefix("ruby-")
  if RUBY_VERSION != required_ruby
    abort "Radar needs Ruby #{required_ruby}; this is #{RUBY_VERSION}. Install it with your version manager " \
          "(asdf, mise, rbenv), then run bin/setup again."
  end
  abort "git is not installed. Install it, then run bin/setup again." unless found?("git")
  puts "Ruby #{RUBY_VERSION} and git are here."
  if found?("claude")
    puts "Claude Code is here: #{`claude --version 2>/dev/null`.strip}"
  else
    puts "Claude Code was not found on the PATH. Setup in the browser shows how to install it, or where to point Radar at it."
  end

  say "Installing dependencies"
  system("bundle check > /dev/null") || system!("bundle install")

  say "Preparing the databases"
  if ARGV.include?("--reset")
    system! "bin/rails db:reset"
    FileUtils.rm_rf("storage/career")
    FileUtils.rm_f(Dir["storage/upwork_tokens*.json"])
    puts "Started over. Your repositories were not touched."
  else
    system! "bin/rails db:prepare"
  end

  say "Building the stylesheet"
  system! "bin/rails tailwindcss:build"

  say "Tidying logs"
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    say "Starting Radar on http://localhost:#{PORT}"
    puts "Open that address in your browser. Setup takes it from there."
    STDOUT.flush
    exec({ "PORT" => PORT }, "bin/dev")
  end
end
